# .env.local

# URL of your GoToSocial instance
GTS_URL="https://freelifemakers.com"

# GTS ID,Secret
AUTH_GOTOSOCIAL_ID="your-gotosocial-id"
AUTH_GOTOSOCIAL_SECRET="your-gotosocial-secret"

# npx auth secret  or openssl rand -base64 32 로 생성
AUTH_SECRET="your-secret-key" 
AUTH_URL="http://localhost:3000"
