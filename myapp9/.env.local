# .env.local

# URL of your GoToSocial instance
GTS_URL="https://freelifemakers.com"

# GTS ID,Secret
AUTH_GOTOSOCIAL_ID="your_gotosocial_id"
AUTH_GOTOSOCIAL_SECRET="your_gotosocial_secret"

# npx auth secret  or openssl rand -base64 32
AUTH_SECRET="your_auth_secret"
AUTH_URL="http://localhost:3000"
